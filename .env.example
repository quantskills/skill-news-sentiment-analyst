# ============================================================
# PandaAI 数据服务 凭证配置
# ============================================================
# 1. 复制此文件为 .env :  cp .env.example .env
# 2. 填入你在 https://www.pandaai.online 的登录凭证
# 3. .env 已加入 .gitignore，不会被提交到 GitHub
# ============================================================

# 方式A: 如果你有 API Token（推荐）
PANDA_DATA_TOKEN=

# 方式B: 账号密码登录（panda_data SDK 支持时使用）
PANDA_DATA_USERNAME=
PANDA_DATA_PASSWORD=

# ============================================================
# 注意: PandaAI 是可选的增强功能
# 不配置也可以正常采集新闻和生成 LLM prompt
# 配置后可以: 回测信号胜率 / 资金流向验证 / 内部人信号检查
# ============================================================
